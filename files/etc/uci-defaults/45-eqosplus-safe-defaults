#!/bin/sh

logger -t eqosplus-safe-defaults "disable EQOS Plus sample device rules only"

# Some luci-app-eqosplus package defaults include sample device entries such as
# 192.168.10.10 and 192.168.10.10-192.168.10.200. Disable only these sample
# entries. Do not change the global EQOS Plus switch, service autostart, or
# existing tc state, otherwise preserved user rules can be unexpectedly cleared.

changed=0
idx=0
while uci -q get eqosplus.@device[$idx] >/dev/null 2>&1; do
    target="$(uci -q get eqosplus.@device[$idx].mac 2>/dev/null || true)"
    case "$target" in
        192.168.10.10|192.168.10.10-192.168.10.200)
            if [ "$(uci -q get eqosplus.@device[$idx].enable 2>/dev/null || true)" != "0" ]; then
                uci -q set eqosplus.@device[$idx].enable='0'
                changed=1
            fi
        ;;
    esac
    idx=$((idx + 1))
done

[ "$changed" = "1" ] && uci -q commit eqosplus

logger -t eqosplus-safe-defaults "done"
exit 0
