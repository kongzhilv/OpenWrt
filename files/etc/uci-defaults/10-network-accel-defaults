#!/bin/sh

logger -t network-accel-defaults "preserve network acceleration defaults"

# Keep flow/offload settings unchanged. EQOS/Netdata diagnostics should not force
# firewall or Turbo ACC offload policy; users can control it from LuCI/SSH.
uci -q set turboacc.config.fullcone_nat='1'
uci -q set turboacc.config.fullcone6='0'
uci -q set turboacc.config.bbr_cca='1'
uci -q commit turboacc

logger -t network-accel-defaults "done"
exit 0
