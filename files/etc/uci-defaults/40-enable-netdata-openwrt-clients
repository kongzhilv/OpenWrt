#!/bin/sh

logger -t netdata-openwrt-clients "enable OpenWrt client realtime traffic charts"

# OpenWrt's Netdata package starts plugins from /usr/lib/netdata/plugins.d.
# Keep compatibility with older overlay path by copying the plugin from libexec
# when needed.
PLUGIN_SRC="/usr/libexec/netdata/plugins.d/openwrt_clients.plugin"
PLUGIN_DIR="/usr/lib/netdata/plugins.d"
PLUGIN="$PLUGIN_DIR/openwrt_clients.plugin"

mkdir -p "$PLUGIN_DIR" 2>/dev/null || true
if [ -f "$PLUGIN_SRC" ] && [ ! -f "$PLUGIN" ]; then
    cp -f "$PLUGIN_SRC" "$PLUGIN" 2>/dev/null || true
fi

# Default config. Refresh choices are intentionally limited in the plugin to
# 1/3/5/10 seconds. Default 3s keeps realtime feel with lower CPU usage.
if ! uci -q get netdata_clients.main >/dev/null 2>&1; then
    uci set netdata_clients.main='netdata_clients'
    uci set netdata_clients.main.enabled='1'
    uci set netdata_clients.main.lan_dev='br-lan'
    uci set netdata_clients.main.update_every='3'
    uci set netdata_clients.main.rescan_every='60'
    uci set netdata_clients.main.max_clients='64'
    uci commit netdata_clients
fi

if [ -f "$PLUGIN" ]; then
    chmod +x "$PLUGIN" 2>/dev/null || true
fi

# Prepare the nft table early. The plugin will resync chains/counters dynamically.
if command -v nft >/dev/null 2>&1; then
    nft add table inet openwrt_clients 2>/dev/null || true
    nft add chain inet openwrt_clients forward '{ type filter hook forward priority -250; policy accept; }' 2>/dev/null || true
fi

# Netdata external plugins in plugins.d are auto-discovered when executable.
if [ -x /etc/init.d/netdata ]; then
    /etc/init.d/netdata enable 2>/dev/null || true
    /etc/init.d/netdata restart 2>/dev/null || true
fi

logger -t netdata-openwrt-clients "done"
exit 0
