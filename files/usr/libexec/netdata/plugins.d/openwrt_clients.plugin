#!/bin/sh
# Netdata external plugin: OpenWrt per-client IPv4/IPv6 realtime traffic.
# UI layout: one chart per client with Chinese labels and IPv4/IPv6 dimensions.
# Data source: nftables named counters in inet/openwrt_clients.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
TABLE="openwrt_clients"
CHAIN="forward"
CHART_NS="openwrt_clients_zh"
CHART_CONTEXT="openwrt_clients_zh.client_rate"

uci_get() {
    command -v uci >/dev/null 2>&1 || return 1
    uci -q get "$1" 2>/dev/null
}

UCI_ENABLED="$(uci_get netdata_clients.main.enabled || true)"
[ "$UCI_ENABLED" = "0" ] && { echo "DISABLE"; exit 0; }

UCI_LAN_DEV="$(uci_get netdata_clients.main.lan_dev || true)"
UCI_UPDATE_EVERY="$(uci_get netdata_clients.main.update_every || true)"
UCI_RESCAN_EVERY="$(uci_get netdata_clients.main.rescan_every || true)"
UCI_MAX_CLIENTS="$(uci_get netdata_clients.main.max_clients || true)"

LAN_DEV="${OPENWRT_CLIENTS_LAN_DEV:-${UCI_LAN_DEV:-br-lan}}"
RAW_UPDATE_EVERY="${OPENWRT_CLIENTS_UPDATE_EVERY:-${UCI_UPDATE_EVERY:-${1:-${NETDATA_UPDATE_EVERY:-3}}}}"
RAW_RESCAN_EVERY="${OPENWRT_CLIENTS_RESCAN_EVERY:-${UCI_RESCAN_EVERY:-60}}"
RAW_MAX_CLIENTS="${OPENWRT_CLIENTS_MAX_CLIENTS:-${UCI_MAX_CLIENTS:-64}}"

# Keep refresh predictable on small routers. Supported values: 1/3/5/10 seconds.
case "$RAW_UPDATE_EVERY" in
    1|3|5|10) UPDATE_EVERY="$RAW_UPDATE_EVERY" ;;
    *) UPDATE_EVERY=3 ;;
esac

case "$RAW_RESCAN_EVERY" in
    ''|*[!0-9]*) RESCAN_EVERY=60 ;;
    *) RESCAN_EVERY="$RAW_RESCAN_EVERY" ;;
esac
[ "$RESCAN_EVERY" -lt 30 ] 2>/dev/null && RESCAN_EVERY=30

case "$RAW_MAX_CLIENTS" in
    ''|*[!0-9]*) MAX_CLIENTS=64 ;;
    *) MAX_CLIENTS="$RAW_MAX_CLIENTS" ;;
esac
[ "$MAX_CLIENTS" -lt 1 ] 2>/dev/null && MAX_CLIENTS=1
[ "$MAX_CLIENTS" -gt 128 ] 2>/dev/null && MAX_CLIENTS=128

CACHE_BASE="${NETDATA_CACHE_DIR:-/tmp}/openwrt_clients"
mkdir -p "$CACHE_BASE" 2>/dev/null || CACHE_BASE="/tmp/openwrt_clients"
mkdir -p "$CACHE_BASE" 2>/dev/null || exit 1

CLIENTS="$CACHE_BASE/clients"
CLIENTS_RAW="$CACHE_BASE/clients.raw"
CLIENTS_NEW="$CACHE_BASE/clients.new"
COUNTERS="$CACHE_BASE/counters"
COUNTER_VALUES="$CACHE_BASE/counter_values"

log() {
    echo "openwrt_clients: $*" >&2
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        log "missing command: $1"
        echo "DISABLE"
        exit 1
    }
}

valid_ipv4() {
    local ip="$1" o n
    case "$ip" in
        *[!0-9.]*|*..*|.*|*.) return 1 ;;
    esac
    OLD_IFS="$IFS"
    IFS='.'
    set -- $ip
    IFS="$OLD_IFS"
    [ "$#" -eq 4 ] || return 1
    for o in "$@"; do
        [ -n "$o" ] || return 1
        n=$((o + 0)) 2>/dev/null || return 1
        [ "$n" -ge 0 ] && [ "$n" -le 255 ] || return 1
    done
    return 0
}

init_nft() {
    nft add table inet "$TABLE" 2>/dev/null || true
    nft add chain inet "$TABLE" "$CHAIN" '{ type filter hook forward priority -250; policy accept; }' 2>/dev/null || true
}

discover_clients() {
    : > "$CLIENTS_RAW"

    # DHCP lease format: expires mac ip hostname clientid.
    if [ -r /tmp/dhcp.leases ]; then
        awk '
            $3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
                h=$4
                if (h=="" || h=="*") h="unknown"
                print "4", $3, tolower($2), h
            }
        ' /tmp/dhcp.leases >> "$CLIENTS_RAW"
    fi

    # IPv4 neighbors supply clients that have no current DHCP lease.
    ip -4 neigh show dev "$LAN_DEV" 2>/dev/null | awk '
        $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
            mac="00:00:00:00:00:00"
            for (i=1; i<=NF; i++) if ($i=="lladdr" && (i+1)<=NF) mac=$(i+1)
            print "4", $1, tolower(mac), "unknown"
        }
    ' >> "$CLIENTS_RAW"

    # IPv6 neighbors are grouped by MAC. Skip link-local, multicast and failed entries.
    ip -6 neigh show dev "$LAN_DEV" 2>/dev/null | awk '
        $1 !~ /^fe80:/ && $1 !~ /^ff/ && $1 != "::" {
            ip=$1
            mac=""
            failed=0
            for (i=1; i<=NF; i++) {
                if ($i=="lladdr" && (i+1)<=NF) mac=$(i+1)
                if ($i=="FAILED") failed=1
            }
            if (!failed && mac ~ /^[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]$/) {
                print "6", ip, tolower(mac), "unknown"
            }
        }
    ' >> "$CLIENTS_RAW"

    awk '
        function valid_mac(m) {
            return (m ~ /^[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]$/ && m != "00:00:00:00:00:00")
        }
        function add(list, val) {
            if (val == "") return list
            if (list == "") return val
            return list "," val
        }
        function safe_id(s) {
            gsub(/[^A-Za-z0-9_]/, "_", s)
            gsub(/^_+/, "", s)
            gsub(/_+$/, "", s)
            gsub(/_+/, "_", s)
            if (s == "") s="unknown"
            return "client_" s
        }
        function clean_host(h) {
            if (h == "" || h == "*") h="unknown"
            gsub(/[^A-Za-z0-9._-]/, "_", h)
            gsub(/^_+/, "", h)
            gsub(/_+$/, "", h)
            if (h == "") h="unknown"
            return h
        }
        {
            fam=$1
            ip=$2
            mac=tolower($3)
            host=clean_host($4)
            key=valid_mac(mac) ? "mac_" mac : "ip_" ip
            if (!(key in seen_key)) {
                seen_key[key]=1
                order[++n]=key
                mac_by_key[key]=valid_mac(mac) ? mac : "00:00:00:00:00:00"
                host_by_key[key]="unknown"
                ip4_by_key[key]=""
                ip6_by_key[key]=""
            }
            if (host != "unknown") host_by_key[key]=host
            if (fam == "4" && !(key SUBSEP ip in seen4)) {
                seen4[key SUBSEP ip]=1
                ip4_by_key[key]=add(ip4_by_key[key], ip)
            }
            if (fam == "6" && !(key SUBSEP ip in seen6)) {
                seen6[key SUBSEP ip]=1
                ip6_by_key[key]=add(ip6_by_key[key], ip)
            }
        }
        END {
            count=0
            for (i=1; i<=n && count<max; i++) {
                key=order[i]
                ip4=ip4_by_key[key]
                ip6=ip6_by_key[key]
                if (ip4 == "" && ip6 == "") continue
                dim=safe_id(key)
                host=host_by_key[key]
                if (host == "") host="unknown"
                mac=mac_by_key[key]
                if (ip4 == "") ip4="-"
                if (ip6 == "") ip6="-"
                printf "%s %s %s %s %s up4_%s down4_%s up6_%s down6_%s\n", ip4, ip6, mac, host, dim, dim, dim, dim, dim
                count++
            }
        }
    ' max="$MAX_CLIENTS" "$CLIENTS_RAW" > "$CLIENTS_NEW"

    mv "$CLIENTS_NEW" "$CLIENTS"
}

sync_nft_rules() {
    init_nft
    nft flush chain inet "$TABLE" "$CHAIN" 2>/dev/null || true

    while read -r ip4s ip6s mac host dim up4 down4 up6 down6; do
        [ -n "$dim" ] || continue
        nft add counter inet "$TABLE" "$up4" 2>/dev/null || true
        nft add counter inet "$TABLE" "$down4" 2>/dev/null || true
        nft add counter inet "$TABLE" "$up6" 2>/dev/null || true
        nft add counter inet "$TABLE" "$down6" 2>/dev/null || true

        if [ "$ip4s" != "-" ]; then
            OLD_IFS="$IFS"
            IFS=','
            for ip4 in $ip4s; do
                valid_ipv4 "$ip4" || continue
                nft add rule inet "$TABLE" "$CHAIN" ip saddr "$ip4" counter name "$up4" 2>/dev/null || true
                nft add rule inet "$TABLE" "$CHAIN" ip daddr "$ip4" counter name "$down4" 2>/dev/null || true
            done
            IFS="$OLD_IFS"
        fi

        if [ "$ip6s" != "-" ]; then
            OLD_IFS="$IFS"
            IFS=','
            for ip6 in $ip6s; do
                [ -n "$ip6" ] || continue
                nft add rule inet "$TABLE" "$CHAIN" ip6 saddr "$ip6" counter name "$up6" 2>/dev/null || true
                nft add rule inet "$TABLE" "$CHAIN" ip6 daddr "$ip6" counter name "$down6" 2>/dev/null || true
            done
            IFS="$OLD_IFS"
        fi
    done < "$CLIENTS"
}

emit_charts() {
    # Do not emit a no_clients placeholder chart. Netdata keeps charts it has
    # seen, so a temporary empty scan would otherwise leave a fake first chart.
    [ -s "$CLIENTS" ] || return 0

    prio=70000
    while read -r ip4s ip6s mac host dim up4 down4 up6 down6; do
        [ -n "$dim" ] || continue
        chart="$CHART_NS.$dim"
        label="$ip4s"
        [ "$label" = "-" ] && label="$mac"
        title="客户端 ${host} (${label})"
        family="${host} ${label}"
        echo "CHART $chart '' '$title' 'KB/s' '$family' $CHART_CONTEXT line $prio $UPDATE_EVERY"
        echo "DIMENSION download4 'IPv4下载' incremental 1 1024"
        echo "DIMENSION upload4 'IPv4上传' incremental 1 1024"
        echo "DIMENSION download6 'IPv6下载' incremental 1 1024"
        echo "DIMENSION upload6 'IPv6上传' incremental 1 1024"
        prio=$((prio + 1))
    done < "$CLIENTS"
}

parse_counters_once() {
    nft list counters table inet "$TABLE" > "$COUNTERS" 2>/dev/null || : > "$COUNTERS"
    awk '
        $1=="counter" {c=$2}
        c != "" {
            for (i=1; i<=NF; i++) {
                if ($i=="bytes") {print c, $(i+1); c=""; break}
            }
        }
    ' "$COUNTERS" > "$COUNTER_VALUES"
}

counter_value() {
    local counter="$1"
    awk -v c="$counter" '$1==c {print $2; found=1; exit} END {if (!found) print 0}' "$COUNTER_VALUES"
}

emit_values() {
    [ -s "$CLIENTS" ] || return 0

    parse_counters_once

    while read -r ip4s ip6s mac host dim up4 down4 up6 down6; do
        [ -n "$dim" ] || continue
        chart="$CHART_NS.$dim"
        down4_val="$(counter_value "$down4")"
        up4_val="$(counter_value "$up4")"
        down6_val="$(counter_value "$down6")"
        up6_val="$(counter_value "$up6")"
        echo "BEGIN $chart"
        echo "SET download4 = $down4_val"
        echo "SET upload4 = $up4_val"
        echo "SET download6 = $down6_val"
        echo "SET upload6 = $up6_val"
        echo "END"
    done < "$CLIENTS"
}

need_cmd nft
need_cmd ip

# Always start from a fresh client scan. Netdata may preserve old chart DBs, but
# the plugin should never trust a stale tmp client list.
rm -f "$CLIENTS" "$CLIENTS_RAW" "$CLIENTS_NEW" "$COUNTERS" "$COUNTER_VALUES" 2>/dev/null || true

last_rescan=0
while :; do
    now="$(date +%s 2>/dev/null || echo 0)"
    if [ ! -s "$CLIENTS" ] || [ $((now - last_rescan)) -ge "$RESCAN_EVERY" ]; then
        discover_clients
        sync_nft_rules
        emit_charts
        last_rescan="$now"
    fi

    emit_values
    sleep "$UPDATE_EVERY"
done
