#!/bin/sh
# Netdata external plugin: OpenWrt per-client IPv4 realtime traffic.
# Data source: nftables named counters in inet/openwrt_clients.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
TABLE="openwrt_clients"
CHAIN="forward"

uci_get() {
    command -v uci >/dev/null 2>&1 || return 1
    uci -q get "$1" 2>/dev/null
}

UCI_ENABLED="$(uci_get netdata_clients.main.enabled || true)"
[ "$UCI_ENABLED" = "0" ] && { echo "DISABLE"; exit 0; }

UCI_LAN_DEV="$(uci_get netdata_clients.main.lan_dev || true)"
UCI_UPDATE_EVERY="$(uci_get netdata_clients.main.update_every || true)"
UCI_RESCAN_EVERY="$(uci_get netdata_clients.main.rescan_every || true)"
UCI_MAX_CLIENTS="$(uci_get netdata_clients.main.max_clients || true)"

LAN_DEV="${OPENWRT_CLIENTS_LAN_DEV:-${UCI_LAN_DEV:-br-lan}}"
RAW_UPDATE_EVERY="${OPENWRT_CLIENTS_UPDATE_EVERY:-${UCI_UPDATE_EVERY:-${1:-${NETDATA_UPDATE_EVERY:-3}}}}"
RAW_RESCAN_EVERY="${OPENWRT_CLIENTS_RESCAN_EVERY:-${UCI_RESCAN_EVERY:-60}}"
RAW_MAX_CLIENTS="${OPENWRT_CLIENTS_MAX_CLIENTS:-${UCI_MAX_CLIENTS:-64}}"

# Keep refresh predictable on small routers. Supported values: 1/3/5/10 seconds.
case "$RAW_UPDATE_EVERY" in
    1|3|5|10) UPDATE_EVERY="$RAW_UPDATE_EVERY" ;;
    *) UPDATE_EVERY=3 ;;
esac

case "$RAW_RESCAN_EVERY" in
    ''|*[!0-9]*) RESCAN_EVERY=60 ;;
    *) RESCAN_EVERY="$RAW_RESCAN_EVERY" ;;
esac
[ "$RESCAN_EVERY" -lt 30 ] 2>/dev/null && RESCAN_EVERY=30

case "$RAW_MAX_CLIENTS" in
    ''|*[!0-9]*) MAX_CLIENTS=64 ;;
    *) MAX_CLIENTS="$RAW_MAX_CLIENTS" ;;
esac
[ "$MAX_CLIENTS" -lt 1 ] 2>/dev/null && MAX_CLIENTS=1
[ "$MAX_CLIENTS" -gt 128 ] 2>/dev/null && MAX_CLIENTS=128

CACHE_BASE="${NETDATA_CACHE_DIR:-/tmp}/openwrt_clients"
mkdir -p "$CACHE_BASE" 2>/dev/null || CACHE_BASE="/tmp/openwrt_clients"
mkdir -p "$CACHE_BASE" 2>/dev/null || exit 1

CLIENTS="$CACHE_BASE/clients"
CLIENTS_RAW="$CACHE_BASE/clients.raw"
CLIENTS_NEW="$CACHE_BASE/clients.new"
COUNTERS="$CACHE_BASE/counters"
COUNTER_VALUES="$CACHE_BASE/counter_values"

log() {
    echo "openwrt_clients: $*" >&2
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || {
        log "missing command: $1"
        echo "DISABLE"
        exit 1
    }
}

valid_ipv4() {
    local ip="$1" o n
    case "$ip" in
        *[!0-9.]*|*..*|.*|*.) return 1 ;;
    esac
    OLD_IFS="$IFS"
    IFS='.'
    set -- $ip
    IFS="$OLD_IFS"
    [ "$#" -eq 4 ] || return 1
    for o in "$@"; do
        [ -n "$o" ] || return 1
        n=$((o + 0)) 2>/dev/null || return 1
        [ "$n" -ge 0 ] && [ "$n" -le 255 ] || return 1
    done
    return 0
}

sanitize_id() {
    echo "$1" | sed 's/[^A-Za-z0-9_]/_/g; s/^_*//; s/_\{2,\}/_/g; s/^/client_/; s/_$//'
}

sanitize_label() {
    echo "$1" | sed 's/[^A-Za-z0-9._-]/_/g; s/_\{2,\}/_/g; s/^_*//; s/_*$//' | cut -c1-48
}

init_nft() {
    nft add table inet "$TABLE" 2>/dev/null || true
    nft add chain inet "$TABLE" "$CHAIN" '{ type filter hook forward priority -250; policy accept; }' 2>/dev/null || true
}

discover_clients() {
    : > "$CLIENTS_RAW"

    # DHCP lease format: expires mac ip hostname clientid.
    if [ -r /tmp/dhcp.leases ]; then
        awk '{ if ($3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { h=$4; if (h=="" || h=="*") h="unknown"; print $3, $2, h } }' /tmp/dhcp.leases >> "$CLIENTS_RAW"
    fi

    # Add currently visible IPv4 neighbors on LAN; DHCP names win during de-duplication.
    ip -4 neigh show dev "$LAN_DEV" 2>/dev/null | awk '
        $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
            mac="00:00:00:00:00:00"
            for (i=1; i<=NF; i++) if ($i=="lladdr" && (i+1)<=NF) mac=$(i+1)
            print $1, mac, "unknown"
        }' >> "$CLIENTS_RAW"

    : > "$CLIENTS_NEW"
    awk '!seen[$1]++ {print $1, $2, $3}' "$CLIENTS_RAW" | head -n "$MAX_CLIENTS" | while read -r ip mac host; do
        [ -n "$ip" ] || continue
        valid_ipv4 "$ip" || continue
        [ -n "$host" ] || host="unknown"
        dim="$(sanitize_id "$ip")"
        label_host="$(sanitize_label "$host")"
        [ -n "$label_host" ] || label_host="unknown"
        printf '%s %s %s %s up_%s down_%s\n' "$ip" "$mac" "$label_host" "$dim" "$dim" "$dim" >> "$CLIENTS_NEW"
    done
    mv "$CLIENTS_NEW" "$CLIENTS"
}

sync_nft_rules() {
    init_nft
    nft flush chain inet "$TABLE" "$CHAIN" 2>/dev/null || true

    while read -r ip mac host dim up down; do
        [ -n "$ip" ] || continue
        nft add counter inet "$TABLE" "$up" 2>/dev/null || true
        nft add counter inet "$TABLE" "$down" 2>/dev/null || true
        nft add rule inet "$TABLE" "$CHAIN" ip saddr "$ip" counter name "$up" 2>/dev/null || true
        nft add rule inet "$TABLE" "$CHAIN" ip daddr "$ip" counter name "$down" 2>/dev/null || true
    done < "$CLIENTS"
}

emit_charts() {
    echo "CHART openwrt_clients.download '' 'OpenWrt 客户端下载速率' 'bits/s' '客户端流量' openwrt.clients.download line 70000 $UPDATE_EVERY"
    if [ -s "$CLIENTS" ]; then
        while read -r ip mac host dim up down; do
            echo "DIMENSION $dim '${host}_${ip}' incremental 8 1"
        done < "$CLIENTS"
    else
        echo "DIMENSION no_clients '无客户端' absolute 1 1"
    fi

    echo "CHART openwrt_clients.upload '' 'OpenWrt 客户端上传速率' 'bits/s' '客户端流量' openwrt.clients.upload line 70001 $UPDATE_EVERY"
    if [ -s "$CLIENTS" ]; then
        while read -r ip mac host dim up down; do
            echo "DIMENSION $dim '${host}_${ip}' incremental 8 1"
        done < "$CLIENTS"
    else
        echo "DIMENSION no_clients '无客户端' absolute 1 1"
    fi
}

parse_counters_once() {
    nft list counters table inet "$TABLE" > "$COUNTERS" 2>/dev/null || : > "$COUNTERS"
    awk '
        $1=="counter" {c=$2}
        c != "" {
            for (i=1; i<=NF; i++) {
                if ($i=="bytes") {print c, $(i+1); c=""; break}
            }
        }
    ' "$COUNTERS" > "$COUNTER_VALUES"
}

emit_values() {
    parse_counters_once

    echo "BEGIN openwrt_clients.download"
    if [ -s "$CLIENTS" ]; then
        awk 'NR==FNR {v[$1]=$2; next} {val=v[$6]; if (val=="") val=0; print "SET "$4" = "val}' "$COUNTER_VALUES" "$CLIENTS"
    else
        echo "SET no_clients = 0"
    fi
    echo "END"

    echo "BEGIN openwrt_clients.upload"
    if [ -s "$CLIENTS" ]; then
        awk 'NR==FNR {v[$1]=$2; next} {val=v[$5]; if (val=="") val=0; print "SET "$4" = "val}' "$COUNTER_VALUES" "$CLIENTS"
    else
        echo "SET no_clients = 0"
    fi
    echo "END"
}

need_cmd nft
need_cmd ip

last_rescan=0
while :; do
    now="$(date +%s 2>/dev/null || echo 0)"
    if [ ! -s "$CLIENTS" ] || [ $((now - last_rescan)) -ge "$RESCAN_EVERY" ]; then
        discover_clients
        sync_nft_rules
        emit_charts
        last_rescan="$now"
    fi

    emit_values
    sleep "$UPDATE_EVERY"
done
